<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_aeropay" model="payment.provider">
        <field name="name">Market Pay (QR Bolivia)</field>
        <field name="code">aeropay</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="redirect_form_view_id" ref="payment_aeropay.redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_aeropay.payment_method_aeropay')])]"/>
        <field name="state">disabled</field>
        <field name="aeropay_api_url">https://market.com.bo/api/v1/pay</field>
    </record>
</odoo>
