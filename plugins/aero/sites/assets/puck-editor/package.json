{
  "name": "aero-sites-puck-editor",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "vite build && node scripts/export-catalog.mjs && npm run build:editor-css",
    "build:editor-css": "../../../../../themes/microsites/node_modules/.bin/tailwindcss -i src/editor.css -o ../../formwidgets/puckeditor/assets/puck-editor-theme.css -c tailwind.editor.config.js --minify",
    "dev": "vite build --watch",
    "export-catalog": "node scripts/export-catalog.mjs"
  },
  "dependencies": {
    "@puckeditor/core": "0.22.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
