{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ViralObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject", "s3:GetObject", "s3:DeleteObject",
        "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET/viral/*"
    },
    {
      "Sid": "ViralList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["viral/*"] } }
    },
    {
      "Sid": "ViralDiagnostics",
      "Effect": "Allow",
      "Action": ["s3:GetBucketCors", "s3:GetBucketPublicAccessBlock", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET"
    }
  ]
}
