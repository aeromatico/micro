#!/usr/bin/env bash
#
# Docs Sync — hook post-commit (OPCIONAL: acelerador del vigilante)
#
# Ya NO ejecuta el agente en cada commit. Solo le avisa al vigilante docs-sync-watch,
# que decide con SUS guardas (criterio determinista sin IA, docs sin editar, plugin sin
# editar, lock, tope diario, backoff). Si el hook se borra o se desactiva no pasa nada:
# el cron del vigilante hace lo mismo cada 30 min.
#
# Instalación:  bin/docs-sync-install.sh --with-hook
# Log:          .opencode/docs-sync.log
#
set -uo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
WATCH="$REPO_ROOT/.opencode/docs-sync-watch.py"
[ -x "$WATCH" ] || exit 0
# Un commit del propio plugin docs o de herramientas nunca dispara nada (lo filtra el vigilante).
nohup "$WATCH" run --quiet --from-hook >/dev/null 2>&1 &
exit 0
