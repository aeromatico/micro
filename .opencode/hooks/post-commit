#!/usr/bin/env bash
#
# Docs Sync — hook post-commit
#
# Cuando un commit toca plugins de Aero (excepto el propio plugin Docs),
# dispara el agente `docs-sync` para documentar/actualizar el lado tenant.
# Corre en segundo plano con lock, para no bloquear el commit ni solaparse.
#
# Instalación:  bin/docs-sync-install.sh
# Log:          .opencode/docs-sync.log
#
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

OPENCODE_BIN="${OPENCODE_BIN:-opencode}"
LOCK="$REPO_ROOT/.opencode/.docs-sync.lock"
LOG="$REPO_ROOT/.opencode/docs-sync.log"

# Un solo proceso a la vez.
[ -e "$LOCK" ] && exit 0

COMMIT="$(git rev-parse HEAD)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# Plugins tocados por el commit (excluye el propio plugin docs y node_modules).
mapfile -t CHANGED < <(
    git show --name-only --pretty=format: "$COMMIT" 2>/dev/null \
        | grep -E '^plugins/aero/' \
        | grep -vE '^plugins/aero/docs/' \
        | grep -vE '/node_modules/' \
        | awk -F/ '{print $3}' \
        | sort -u
)

[ ${#CHANGED[@]} -eq 0 ] && exit 0

PLUGINS=""
for p in "${CHANGED[@]}"; do
    [ -d "plugins/aero/$p" ] && PLUGINS="$PLUGINS aero/$p"
done
[ -z "$PLUGINS" ] && exit 0

# ¿El binario de opencode está disponible?
command -v "$OPENCODE_BIN" >/dev/null 2>&1 || {
    echo "[$(date '+%F %T')] opencode no encontrado en PATH; soy $OPENCODE_BIN" >> "$LOG"
    exit 0
}

mkdir -p "$(dirname "$LOG")"
touch "$LOCK"

(
    trap 'rm -f "$LOCK"' EXIT
    {
        echo "=== $(date '+%F %T') commit=$COMMIT branch=$BRANCH plugins=$PLUGINS ==="
        "$OPENCODE_BIN" run --agent docs-sync \
            "Nuevo commit $COMMIT (rama $BRANCH). Analizá y actualizá la documentación del tenant para estos plugins:$PLUGINS"
    } >> "$LOG" 2>&1
) &
